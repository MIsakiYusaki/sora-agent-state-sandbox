    "task_evidence": {"type": "array"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguous": {"type": "boolean"}, "clarification": {"type": ["string", "null"]}, "unsupported_claims": {"type": "array"},
    "evidence_refs": {"type": "array"}, "model_trace": {"type": "object"}
  },
  "additionalProperties": false
}
