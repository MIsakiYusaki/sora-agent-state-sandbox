{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sora.local/schemas/worldops/UserChoiceInterpretation.v1.schema.json",
  "title": "UserChoiceInterpretation.v1",
  "type": "object",
  "required": ["schema_version", "interpretation_id", "event_instance_id", "input_id", "task_evidence", "confidence", "ambiguous"],
