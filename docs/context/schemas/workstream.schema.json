{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectContextWorkstream.v1",
  "type": "object",
  "required": ["schema_version", "workstream_id", "title", "owner", "status", "paths", "started_at_utc", "updated_at_utc", "summary", "events", "verification"],
  "properties": {
    "schema_version": {"const": "ProjectContextWorkstream.v1"},
    "workstream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "blocked", "completed", "superseded"]},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "summary": {"type": "string"},
    "events": {"type": "array", "minItems": 1},
    "verification": {"type": "array", "items": {"type": "string"}}
  }
}
