{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectContextDecision.v1",
  "type": "object",
  "required": ["schema_version", "decision_id", "title", "status", "decided_at_utc", "context", "decision", "consequences", "references"],
  "properties": {
    "schema_version": {"const": "ProjectContextDecision.v1"},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "decided_at_utc": {"type": "string", "format": "date-time"},
    "context": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "consequences": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}}
  }
}
